# Copy to .env.local (gitignored). Never commit real secrets.
# cp .env.local.example .env.local

# --- Required for M1 (read one Task) ---
# Notion → Settings → Connections → Develop or manage integrations
# → New integration (Internal) → copy "Internal Integration Secret"
NOTION_TOKEN=secret_xxxxxxxx

# Task database ID: open the DB in Notion → URL looks like
#   https://www.notion.so/workspace/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?v=...
# Copy the 32-hex block (dashes optional). Share the DB with the integration.
NOTION_TASK_DB_ID=

# --- Optional (Docs; prefer root-page children) ---
NOTION_DOC_ROOT_PAGE_ID=
# Alternative: Doc as database (only if not using root page)
NOTION_DOC_DB_ID=

# Local API port (web proxies /api → here)
PORT=8787
